{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "메모장",
  "version": "0.1.0",
  "identifier": "kr.geoinno.memo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "메모장",
        "width": 960,
        "height": 640,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
